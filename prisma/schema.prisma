// Busala School Management System - Prisma Schema
// PostgreSQL Database with Multi-Tenant Support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// PLATFORM LAYER (Super Admin)
// ============================================

model Plan {
  id              String   @id @default(cuid())
  name            String   // e.g., "Starter", "Growth", "Enterprise"
  slug            String   @unique // e.g., "starter", "growth", "enterprise"
  description     String?
  
  // Plan Limits
  maxTeachers     Int      @default(10)
  maxStudents     Int      @default(100)
  maxGroups       Int      @default(5)
  maxRooms        Int      @default(3)
  maxLessons      Int      @default(500) // per month
  
  // Pricing (stored in cents)
  priceMonthly    Int      @default(2900) // $29.00
  priceAnnual     Int      @default(29000) // $290.00 (2 months free)
  
  // Features (JSON for flexibility)
  features        Json     @default("[]") // Array of feature strings
  
  // Plan Status
  isActive        Boolean  @default(true)
  isCustom        Boolean  @default(false) // For enterprise custom plans
  
  // Display Order
  sortOrder       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  tenants         Tenant[]
  
  @@index([isActive])
  @@index([sortOrder])
  @@map("plans")
}

model Tenant {
  id                      String             @id @default(cuid())
  
  // Organization Info
  name                    String
  slug                    String             @unique // URL-friendly name
  subdomain               String             @unique // e.g., "cairo-academy"
  
  // Contact Info
  email                   String
  phone                   String?
  logoUrl                 String?
  
  // Address
  address                 String?
  city                    String?
  country                 String             @default("US")
  timezone                String             @default("America/New_York")
  
  // Billing & Plan
  planId                  String
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  subscriptionStatus      SubscriptionStatus @default(trial)
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  
  // Onboarding
  onboardingCompletedAt   DateTime?
  onboardingStep          Int                @default(0) // Current step (0-6)
  
  // Settings
  settings                Json               @default("{}")
  
  // Status
  isActive                Boolean            @default(true)
  suspendedAt             DateTime?
  suspendReason           String?
  
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  
  // Relations
  plan                    Plan               @relation(fields: [planId], references: [id])
  users                   User[]
  invitations             UserInvitation[]
  subscriptionHistory     SubscriptionHistory[]
  auditLogs               TenantAuditLog[]
  teachers                Teacher[]
  students                Student[]
  rooms                   Room[]
  groups                  Group[]
  lessons                 Lesson[]
  recurringPatterns       RecurringPattern[]
  lessonConflicts         LessonConflict[]
  lessonAttendance        LessonAttendance[]
  notifications           Notification[]
  approvals               Approval[]
  
  @@index([subdomain])
  @@index([subscriptionStatus])
  @@index([isActive])
  @@index([planId])
  @@map("tenants")
}

model SubscriptionHistory {
  id                String   @id @default(cuid())
  tenantId          String
  
  // Change Details
  previousPlanId    String?
  newPlanId         String?
  changeType        SubscriptionChangeType
  
  // Amount (for upgrades/downgrades)
  amount            Int?     // in cents
  currency          String   @default("usd")
  
  // Stripe References
  stripeInvoiceId   String?
  
  // Metadata
  reason            String?
  changedBy         String?  // User ID or "system"
  
  createdAt         DateTime @default(now())
  
  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([createdAt])
  @@map("subscription_history")
}

model SuperAdminUser {
  id            String         @id @default(cuid())
  email         String         @unique
  hashedPassword String
  name          String
  role          SuperAdminRole @default(admin)
  
  // Session
  lastLoginAt   DateTime?
  
  // Status
  isActive      Boolean        @default(true)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  auditLogs     PlatformAuditLog[]
  
  @@index([email])
  @@index([isActive])
  @@map("super_admin_users")
}

model PlatformAuditLog {
  id              String   @id @default(cuid())
  
  // Who
  superAdminId    String?
  
  // What
  action          String   // e.g., "tenant.created", "tenant.suspended"
  entityType      String   // e.g., "tenant", "plan"
  entityId        String?
  
  // Details
  before          Json?    // Previous state
  after           Json?    // New state
  metadata        Json?    // Additional context
  
  // Request Info
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
  
  // Relations
  superAdmin      SuperAdminUser? @relation(fields: [superAdminId], references: [id])
  
  @@index([superAdminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ============================================
// AUTH & USER LAYER
// ============================================

model User {
  id              String   @id @default(cuid())
  tenantId        String
  
  // Profile
  email           String
  phone           String?  // For phone/password login
  name            String
  avatarUrl       String?
  
  // Auth - Credentials
  hashedPassword  String?  // Nullable for OAuth-only users
  emailVerified   Boolean  @default(false)
  phoneVerified   Boolean  @default(false)
  
  // Role within tenant
  role            UserRole @default(staff)
  
  // Status
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  
  // Invited by
  invitedById     String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitationsSent UserInvitation[] @relation("InvitedBy")
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserInvitation {
  id              String   @id @default(cuid())
  tenantId        String
  
  // Invitation Details
  email           String
  role            UserRole
  token           String   @unique
  
  // Expiration
  expiresAt       DateTime
  acceptedAt      DateTime?
  
  // Who sent it
  invitedById     String
  
  createdAt       DateTime @default(now())
  
  // Relations
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User     @relation("InvitedBy", fields: [invitedById], references: [id])
  
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_invitations")
}

// ============================================
// SESSION & OAUTH
// ============================================

model Session {
  id        String   @id @default(cuid())
  userId    String
  
  // Session Token (hashed for storage)
  token     String   @unique
  
  // Expiration
  expiresAt DateTime
  
  // Metadata
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  
  // Provider Info
  provider          String // "google", "apple"
  providerAccountId String // Google's sub or Apple's user identifier
  
  // OAuth Tokens (encrypted at application level if needed)
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  
  // Provider-specific data
  email             String?
  name              String?
  picture           String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ============================================
// CORE SCHEDULING DOMAIN
// ============================================

model Teacher {
  id                      String             @id @default(cuid())
  tenantId                String
  
  fullName                String
  email                   String
  phone                   String?
  subjects                String[]
  status                  TeacherStatus      @default(active)
  
  // Availability (JSON for flexibility)
  weeklyAvailability      Json               @default("[]")
  availabilityExceptions  Json               @default("[]")
  
  // Workload
  hoursThisWeek           Float              @default(0)
  maxHours                Float              @default(25)
  
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  
  // Relations
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups                  Group[]
  lessons                 Lesson[]
  
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([status])
  @@index([tenantId, id])
  @@map("teachers")
}

model Student {
  id                String        @id @default(cuid())
  tenantId          String
  
  fullName          String
  email             String
  phone             String?
  parentPhone       String?
  dateOfBirth       DateTime?
  grade             String?
  
  status            StudentStatus @default(active)
  groupIds          String[]
  
  attendancePercent Float         @default(0)
  balance           Float         @default(0)
  plan              String        @default("Monthly Basic")
  enrolledDate      DateTime      @default(now())
  
  notes             String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons           Lesson[]      @relation("StudentLessons")
  
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([status])
  @@map("students")
}

model Room {
  id          String     @id @default(cuid())
  tenantId    String
  
  name        String
  capacity    Int        @default(30)
  status      RoomStatus @default(available)
  floor       String?
  building    String?
  equipment   String[]
  
  notes       String?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups      Group[]
  lessons     Lesson[]
  
  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([status])
  @@map("rooms")
}

model Group {
  id           String   @id @default(cuid())
  tenantId     String
  
  name         String
  description  String?
  subject      String?
  level        String?
  
  teacherId    String
  roomId       String?
  studentIds   String[]
  
  maxCapacity  Int      @default(20)
  scheduleRule Json?    // Recurring schedule definition
  color        String?
  
  academicYear String?
  semester     String?
  
  isActive     Boolean  @default(true)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  lessons      Lesson[]
  
  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([roomId])
  @@map("groups")
}

model Lesson {
  id        String       @id @default(cuid())
  tenantId  String
  
  title     String
  startAt   DateTime
  endAt     DateTime
  type      LessonType   @default(group)
  
  groupId   String?
  studentId String?
  teacherId String
  roomId    String?
  
  status    LessonStatus @default(upcoming)
  
  // For recurring lessons
  isRecurring         Boolean   @default(false)
  recurringPatternId  String?
  
  // Conflict override
  conflictOverriddenBy    String?   // User ID
  conflictOverrideReason  String?
  
  notes     String?
  color     String?
  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  // Relations
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  room      Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  group     Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student?     @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([teacherId])
  @@index([roomId])
  @@index([groupId])
  @@index([studentId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([tenantId, startAt])
  @@map("lessons")
}

model RecurringPattern {
  id                String   @id @default(cuid())
  tenantId          String
  
  // Lesson template
  title             String
  subject           String?
  teacherId         String
  groupId           String?
  roomId            String?
  
  // Schedule
  durationMinutes   Int      @default(60)
  startTime         String   // "HH:MM" format
  daysOfWeek        Int[]    // [1, 3, 5] for Mon, Wed, Fri
  frequency         RecurrenceFrequency @default(weekly)
  
  // Date range
  recurrenceStart   DateTime
  recurrenceEnd     DateTime?
  
  // Generation tracking
  generatedUntil    DateTime?
  
  isActive          Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([isActive])
  @@index([teacherId])
  @@map("recurring_patterns")
}

model LessonConflict {
  id                  String         @id @default(cuid())
  tenantId            String
  lessonId            String
  
  conflictType        ConflictType
  severity            ConflictSeverity @default(error)
  
  // What it conflicts with
  conflictingLessonId String?
  
  // Resolution
  detectedAt          DateTime       @default(now())
  resolvedAt          DateTime?
  resolvedBy          String?        // User ID
  resolution          ConflictResolution?
  
  // Relations
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([lessonId])
  @@index([conflictType])
  @@index([resolvedAt])
  @@map("lesson_conflicts")
}

model LessonAttendance {
  id          String           @id @default(cuid())
  tenantId    String
  lessonId    String
  studentId   String
  
  status      AttendanceStatus @default(present)
  markedAt    DateTime         @default(now())
  markedBy    String           // User ID
  notes       String?
  
  // Relations
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([lessonId, studentId])
  @@index([tenantId])
  @@index([lessonId])
  @@index([studentId])
  @@map("lesson_attendance")
}

// ============================================
// AUDIT & NOTIFICATIONS
// ============================================

model TenantAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  
  // Who
  userId      String?  // Can be null for system actions
  
  // What
  action      String   // e.g., "lesson.created", "teacher.updated"
  entityType  String   // e.g., "lesson", "teacher"
  entityId    String?
  
  // Changes
  before      Json?    // Previous state
  after       Json?    // New state
  
  // Request Info
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("tenant_audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String           // Target user
  
  type      NotificationType
  title     String
  body      String
  data      Json?            // Additional payload
  
  // Status
  readAt    DateTime?
  
  // Action links
  actionUrl String?
  
  createdAt DateTime         @default(now())
  
  // Relations
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// APPROVAL MODEL
// ============================================

model Approval {
  id            String         @id @default(cuid())
  tenantId      String
  
  type          ApprovalType
  title         String
  description   String
  payload       Json           @default("{}")
  status        ApprovalStatus @default(pending)
  priority      Priority       @default(medium)
  
  requesterId   String
  requesterName String
  reviewerId    String?
  reviewerNote  String?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([requesterId])
  @@map("approvals")
}

enum ApprovalType {
  teacher_change
  student_request
  room_change
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum Priority {
  low
  medium
  high
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  owner         // Full access + billing
  admin         // Full access except billing
  coordinator   // Manage schedule, teachers, students
  teacher       // View own schedule only
  staff         // Read-only access
}

enum SuperAdminRole {
  owner
  admin
  support
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  suspended
}

enum SubscriptionChangeType {
  upgrade
  downgrade
  cancel
  reactivate
  trial_end
}

enum TeacherStatus {
  active
  inactive
}

enum StudentStatus {
  active
  at_risk
  inactive
}

enum RoomStatus {
  available
  occupied
  maintenance
}

enum LessonType {
  group
  one_on_one
}

enum LessonStatus {
  upcoming
  in_progress
  completed
  cancelled
}

enum RecurrenceFrequency {
  weekly
  biweekly
  monthly
}

enum ConflictType {
  teacher_double_booked
  room_double_booked
  teacher_unavailable
  student_overlap
}

enum ConflictSeverity {
  error      // Hard conflict - cannot schedule
  warning    // Soft conflict - can override
}

enum ConflictResolution {
  override
  reschedule
  cancel
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum NotificationType {
  lesson_conflict
  lesson_upcoming
  lesson_cancelled
  lesson_rescheduled
  teacher_invitation
  plan_limit_warning
  trial_expiring
  payment_failed
  system
}
